# nexaSMC - Vercel environment variables
# Add these in Vercel > Project > Settings > Environment Variables.

# Public canonical URL used for metadata and the logo inside contact emails.
NEXT_PUBLIC_SITE_URL=https://nexasmc.com

# Contact form SMTP (Namecheap/cPanel mailbox example).
NEXA_SMTP_HOST=server390.web-hosting.com
NEXA_SMTP_PORT=465
NEXA_SMTP_SECURE=true
NEXA_SMTP_USERNAME=info@nexasmc.com
NEXA_SMTP_PASSWORD=PUT_REAL_MAILBOX_PASSWORD_HERE
NEXA_SMTP_FROM_EMAIL=info@nexasmc.com
NEXA_SMTP_FROM_NAME=nexaSMC Website
NEXA_CONTACT_TO_EMAIL=info@nexasmc.com

# Visitor counter storage on Vercel.
# Recommended: Vercel Marketplace > Upstash for Redis > connect to this project.
# The integration normally injects UPSTASH_REDIS_REST_URL and
# UPSTASH_REDIS_REST_TOKEN automatically. KV_REST_API_URL / TOKEN are also
# accepted by this project for compatibility.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional starting value used only before the Redis key exists.
NEXA_VISITOR_SEED=0
